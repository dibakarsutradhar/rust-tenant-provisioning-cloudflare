# ── App ──────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080

# ── Domain ───────────────────────────────────────
BASE_DOMAIN=yourdomain.com
APP_SUBDOMAIN=app           # results in app.yourdomain.com

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/db_name
DB_MAX_CONNECTIONS=5

# ── JWT ──────────────────────────────────────────
JWT_SECRET=super-secret-change-me-in-production
JWT_EXPIRY_DAYS=7

# ── Cloudflare ───────────────────────────────────
CLOUDFLARE_TUNNEL_NAME=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_ID=
MOCK_CLOUDFLARE=true        # set false for real provisioning

# ── Rate Limiting ─────────────────────────────────
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECS=3600
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECS=300

# ── Provisioning Timeouts ─────────────────────────
PROVISION_CNAME_MAX_ATTEMPTS=40
PROVISION_CNAME_POLL_SECS=30
PROVISION_SSL_MAX_ATTEMPTS=40
PROVISION_SSL_POLL_SECS=15
PROVISION_TXT_MAX_ATTEMPTS=40
PROVISION_TXT_POLL_SECS=30

# ── Logging ───────────────────────────────────────
RUST_LOG=info

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────
LOCAL_IP=          # your machine's local IP (ipconfig getifaddr en0)
NGINX_PORT=80